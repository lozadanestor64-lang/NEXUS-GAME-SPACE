<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fase 2: la app sigue sin solicitar ningún permiso. Cada permiso se añadirá solo junto a la función que lo necesite. -->

    <!-- Visibilidad limitada de paquetes: solo apps con actividad lanzable. No se usa QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NexusGameSpace">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NexusGameSpace">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
